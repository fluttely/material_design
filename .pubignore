# Controls what ships in the pub.dev archive.
#
# NOTE: a .pubignore at the package root replaces .gitignore for pub's
# purposes, so the standard build artefacts are repeated here.

# --- Build artefacts ---
.dart_tool/
build/
**/doc/api/
*.iml
.idea/
.vscode/
.DS_Store

# --- Not useful to consumers ---
# The showcase app. It is a full Flutter project (~1.1 MB of platform
# scaffolding) and is published as a web demo instead:
# https://fluttely.github.io/material_design/
demo/

# Obsidian vault of working notes. Tracked in git, but not documentation
# anyone installing the package needs.
documentation/

# Repository tooling: the verification gate and its checkers. Tracked in git
# and run by CI, but of no use to anyone installing the package.
tool/

# Agent-facing context: the format-on-write hook and the /new-scale, /release
# and /verify commands. Shared with contributors, not shipped to consumers.
.claude/

# Local working directories. These are in .gitignore, which does NOT help here —
# a .pubignore at the package root replaces .gitignore entirely, so anything
# gitignored still ships unless it is repeated below. Add new ones here too.
presentation/

# Agent/editor scratch files.
.gemini-cli
.claude-cli
CLAUDE.md
GEMINI.md
utils.js
testing
.env

# --- example/: keep the Dart, drop the platform scaffolding ---
# pub.dev renders example/lib/main.dart and example/README.md; the native
# runners are ~880 KB of noise in the archive.
example/android/
example/ios/
example/linux/
example/macos/
example/windows/
example/web/
example/.dart_tool/
example/build/
example/pubspec.lock
example/test/
example/*.iml
documentation/documentation/
