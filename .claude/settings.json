{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/format-dart.sh"
          }
        ]
      }
    ]
  },
  "permissions": {
    "allow": [
      "Bash(dart format:*)",
      "Bash(dart analyze:*)",
      "Bash(dart run tool/check_triad.dart:*)",
      "Bash(dart run tool/check_changelog.dart:*)",
      "Bash(./tool/verify.sh:*)",
      "Bash(flutter analyze:*)",
      "Bash(flutter test:*)",
      "Bash(flutter pub get:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git show:*)"
    ]
  }
}
